# Global Real Estate Dashboard Backend Configuration
# Copy this file to .env and update the values for your environment

# =====================================================
# SERVER CONFIGURATION
# =====================================================
PORT=3000
NODE_ENV=development

# =====================================================
# DATABASE CONFIGURATION - LOCAL MONGODB
# =====================================================
# Use local MongoDB for development
MONGO_URI=mongodb://localhost:27017/realestate-dashboard

# Cloud MongoDB option (uncomment and use if needed)
# MONGO_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/your-database?retryWrites=true&w=majority

# =====================================================
# SECURITY SETTINGS
# =====================================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_123456789
BCRYPT_ROUNDS=12
JWT_EXPIRES_IN=720h  # 30 days

# =====================================================
# COMPANY CONFIGURATION
# =====================================================
# Set your company identifier (matches config/company.config.js)
COMPANY_ID=default

# =====================================================
# CORS SETTINGS - LOCAL DEVELOPMENT
# =====================================================
# Add your frontend domains (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# =====================================================
# DEFAULT ADMIN USER (for initial setup)
# =====================================================
# These credentials will be used to create the first admin user if none exist
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin123!
DEFAULT_ADMIN_EMAIL=admin@realestate.com
DEFAULT_ADMIN_PHONE=+1-000-000-0000

# =====================================================
# MONGOOSE CONNECTION SETTINGS
# =====================================================
# Connection timeout settings for better reliability
MONGOOSE_SERVER_SELECTION_TIMEOUT=10000
MONGOOSE_SOCKET_TIMEOUT=45000
MONGOOSE_MAX_POOL_SIZE=10
MONGOOSE_MIN_POOL_SIZE=1
MONGOOSE_MAX_IDLE_TIME_MS=30000
MONGOOSE_CONNECT_TIMEOUT_MS=10000